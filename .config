#
# =============================================
# Target: AR750S-EXT (ath79/nand)
# =============================================
#

CONFIG_CCACHE=y

CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y
CONFIG_TARGET_ath79_nand_DEVICE_glinet_gl-ar750s-nor-nand=y

#
# =============================================
# Web 管理界面
# =============================================
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
# Argon 主题（现代界面，替代默认 bootstrap）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

#
# =============================================
# 代理核心（Nikki + mihomo-meta，支持 Clash 订阅与 Mihomo 智能 DNS）
# =============================================
#

CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_yq=y

#
# =============================================
# DNS（Mihomo 内置分流 DNS；dnsmasq-full 负责 DHCP + nftset）
# =============================================
#

CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

#
# =============================================
# WiFi 认证（替换默认 wpad）
# =============================================
#

CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

#
# =============================================
# 内核模块 — 透明代理
# =============================================
#

CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

#
# =============================================
# 内核模块 — SD 卡（内置 USB 读卡器，需 PHY + EHCI 才能枚举）
# =============================================
#

CONFIG_PACKAGE_kmod-phy-ath79-usb=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_block-mount=y

#
# =============================================
# 内核模块 — USB Modem（华为 E372）
# =============================================
#

CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usb-modeswitch-data=y

#
# =============================================
# SD 卡格式化工具
# =============================================
#

CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y

#
# =============================================
# 命令行工具
# =============================================
#

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_usbutils=y

#
# =============================================
# 网络诊断（仅保留常用项，其余需要时再 opkg 安装）
# =============================================
#

# mtr: 路径延迟/丢包（排查代理链路）
CONFIG_PACKAGE_mtr=y
# net-tools: netstat / ifconfig
CONFIG_PACKAGE_net-tools=y

#
# =============================================
# 明确禁用（不需要 KMS 激活服务）
# =============================================
#

# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set

#
# =============================================
# 以下由系统/设备定义自动带入，无需声明
# =============================================
#

# kmod-ath9k                  — 2.4GHz WiFi 驱动
# kmod-ath10k-ct              — 5GHz WiFi 驱动
# ath10k-firmware-qca9887-ct  — 5GHz 固件
# firewall4 / luci-app-firewall — 路由 NAT 必需，与 Nikki 透明代理规则并存
# luci-mod-network            — 网络/WiFi 配置界面
# dropbear                    — SSH 服务
# opkg                        — 包管理器
# luci-app-opkg               — 包管理界面
# uhttpd                      — Web 服务器
# swconfig                    — 交换机配置
# uboot-envtools              — U-Boot 环境变量工具
